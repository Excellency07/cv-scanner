spring.application.name=cv_scanner

# Database Configuration
spring.datasource.url=jdbc:postgresql://localhost:5432/cv_scanner_db
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate (schema is managed by Flyway)
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true

# JWT
jwt.secretKey=YOUR_BASE64_SECRET_KEY
# Milliseconds
jwt.accessTokenExpirationTime=900000
# Minutes
jwt.refreshTokenExpirationTime=3600

# Redis
spring.data.redis.host=localhost
spring.data.redis.port=6379

# MINIO settings
minio.url=http://localhost:9000
minio.access-key=ACCESS_KEY
minio.secret-key=SECRET_KEY
minio.bucket-name=cv-scanner-data

# Flyway
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# Batch
spring.batch.job.enabled=false
spring.batch.jdbc.initialize-schema=always
app.batch.max-concurrent-jobs=2
app.batch.retry.max-attempts=3
app.batch.retry.delay=500ms

spring.servlet.multipart.max-file-size=200MB
spring.servlet.multipart.max-request-size=200MB

# Email notification (optional) - e.g. Mailpit from docker-compose: UI on http://localhost:8025
spring.mail.host=localhost
spring.mail.port=1025
app.notification.enabled=false
app.notification.from=noreply@cvscanner.local
app.notification.hr-email=
