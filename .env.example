# Copy to .env and adjust: cp .env.example .env
DB_USERNAME=cvscanner
DB_PASSWORD=change-me
MINIO_ACCESS_KEY=cvscanner
MINIO_SECRET_KEY=change-me-minio
# Base64 encoded, at least 256 bits. Generate one with: openssl rand -base64 32
JWT_SECRET_KEY=

# ---- Email notification (optional) ----
# Leave these commented out to use Mailpit: every email shows up at http://localhost:8025
# Extra recipient besides the person who uploaded the batch:
#NOTIFICATION_HR_EMAIL=hr@yourcompany.com
#NOTIFICATION_FROM=noreply@cvscanner.local
#
# To send real emails, e.g. with Gmail (needs an App Password, not your normal password:
# Google Account -> Security -> 2-Step Verification -> App passwords):
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USERNAME=your.address@gmail.com
#MAIL_PASSWORD=your-16-char-app-password
#MAIL_SMTP_AUTH=true
#MAIL_STARTTLS=true
#NOTIFICATION_FROM=your.address@gmail.com
